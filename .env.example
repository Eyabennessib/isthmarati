# GEMINI_API_KEY is no longer read by the web app. The Gemini API is proxied
# through a Firebase Cloud Function, and the key lives only on the server.
# To configure it, run:
#   firebase functions:secrets:set GEMINI_API_KEY
# and supply your key when prompted.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
